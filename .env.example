# StudyForge environment configuration template
# Copy this file to .env and fill in your values.
# Real environment variables override .env values.

# 1. Google OAuth Client ID (Web Client) for Google Sign-In
# Leave empty to use email + password sign-in only.
GOOGLE_CLIENT_ID=

# 2. Google OAuth Client Secret (paired with GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_SECRET=

# 3. YouTube Data API v3 Key for lecture video lookup
# Get from Google Cloud Console with YouTube Data API v3 enabled.
YOUTUBE_API_KEY=

# 4. JWT Signing Secret — random 64-char hex string.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
STUDYFORGE_SECRET_KEY=

# 4. Optional: Allowed CORS origins (comma-separated)
# Defaults to https://studyforge-web-five.vercel.app and http://127.0.0.1:3000
CORS_ORIGINS=https://studyforge-web-five.vercel.app,http://127.0.0.1:3000,http://localhost:3000
